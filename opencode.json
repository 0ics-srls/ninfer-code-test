{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen3.8-27b-ninfer",
  "small_model": "local/qwen3.8-27b-ninfer",
  "compaction": { "auto": true },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local (llama-swap)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.8-27b-ninfer": {
          "name": "Qwen3.8-27B on NInfer (V100 + 4090 tensor parallel)",
          "limit": { "context": 262144, "output": 65536 },
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        }
      }
    }
  },
  "mcp": {
    "cvm": {
      "type": "local",
      "command": ["npx", "-y", "cvm-server@latest"],
      "environment": {
        "CVM_STORAGE_TYPE": "file",
        "CVM_DATA_DIR": ".cvm",
        "CVM_LOG_LEVEL": "info",
        "CVM_SANDBOX_PATHS": "."
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-sandbox", "--disable-setuid-sandbox"],
      "enabled": true
    },
    "primeng": {
      "type": "local",
      "command": ["npx", "-y", "@primeng/mcp"],
      "enabled": true
    }
  }
}
